# ============================================================
# CONFIGURAÇÕES LOCAIS
# ============================================================
# Copie este arquivo para um novo arquivo chamado .env.
# Nunca publique o .env real no GitHub.

# Chave padrão da API Gemini. Pode ser substituída temporariamente pela interface.
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI

# Modelo padrão. Também pode ser alterado pela barra lateral durante a sessão.
GEMINI_MODEL=gemini-3.8-flash

# Login único da aplicação
APP_USERNAME=DEFINA_O_USUARIO
APP_PASSWORD=DEFINA_UMA_SENHA_FORTE

# Identificação da versão exibida na aplicação
APP_VERSION=1.0.0

# Fallback opcional para ambientes em que o Git não esteja disponível.
# Em um repositório Git normal, o app tenta obter o commit automaticamente.
GIT_COMMIT=
