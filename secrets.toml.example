# Exemplo para os Secrets do Streamlit Community Cloud.
# NÃO coloque valores reais neste arquivo antes de publicar no GitHub.

# Chave padrão. Pode ser substituída temporariamente pela interface.
GEMINI_API_KEY = "COLE_SUA_CHAVE_AQUI"

# Modelo preferencial. O app consulta os modelos disponíveis para a chave.
GEMINI_MODEL = "gemini-3.6-flash"

APP_USERNAME = "DEFINA_O_USUARIO"
APP_PASSWORD = "DEFINA_UMA_SENHA_FORTE"

APP_VERSION = "2.0.0"

# Use somente como fallback caso o ambiente hospedado não exponha o repositório Git.
# Depois do commit final, este valor pode receber o hash curto correspondente.
GIT_COMMIT = ""

# URL privada do PostgreSQL. Não coloque a string real neste arquivo de exemplo.
DATABASE_URL = "postgresql://usuario:senha@host:5432/banco?sslmode=require"
